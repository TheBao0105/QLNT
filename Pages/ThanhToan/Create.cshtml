@page
@model QLNT.Pages_ThanhToan.CreateModel

@{
    ViewData["Title"] = "Thanh toán hóa đơn";
}

<h1>Thanh toán hóa đơn</h1>

<hr />

@if (Model.HoaDonDangThanhToan != null)
{
    <div class="card mb-4">
        <div class="card-body">
            <h5>Thông tin hóa đơn</h5>

            <p>
                <strong>Phòng:</strong>
                @Model.HoaDonDangThanhToan.TenPhong
            </p>

            <p>
                <strong>Khách thuê:</strong>
                @Model.HoaDonDangThanhToan.HopDong?.NguoiThue?.HoTen
            </p>

            <p>
                <strong>Tháng/Năm:</strong>
                @Model.HoaDonDangThanhToan.Thang/@Model.HoaDonDangThanhToan.Nam
            </p>

            <p>
                <strong>Tổng tiền:</strong>
                @Model.HoaDonDangThanhToan.TongTien.ToString("N0", new System.Globalization.CultureInfo("vi-VN")) VNĐ
            </p>
        </div>
    </div>
}

<div class="row">
    <div class="col-md-5">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input asp-for="ThanhToan.HoaDonId" type="hidden" />

            <div class="form-group mb-3">
                <label class="control-label">
                    Số tiền thanh toán
                </label>

                <input asp-for="SoTienHienThi" class="form-control" readonly />

                <input asp-for="ThanhToan.SoTien" type="hidden" />

                <span asp-validation-for="SoTienHienThi" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ThanhToan.PhuongThuc" class="control-label">
                    Phương thức thanh toán
                </label>

                <select asp-for="ThanhToan.PhuongThuc" class="form-control">
                    <option value="Tiền mặt">Tiền mặt</option>
                    <option value="Chuyển khoản">Chuyển khoản</option>
                    <option value="Ví điện tử">Ví điện tử</option>
                </select>

                <span asp-validation-for="ThanhToan.PhuongThuc" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ThanhToan.NgayThanhToan" class="control-label">
                    Ngày thanh toán
                </label>

                <input asp-for="ThanhToan.NgayThanhToan" class="form-control" type="date" />

                <span asp-validation-for="ThanhToan.NgayThanhToan" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ThanhToan.GhiChu" class="control-label">
                    Ghi chú
                </label>

                <input asp-for="ThanhToan.GhiChu" class="form-control" />

                <span asp-validation-for="ThanhToan.GhiChu" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Xác nhận thanh toán" class="btn btn-primary" />
                <a asp-page="/HoaDon/Index" class="btn btn-secondary">Quay lại</a>
            </div>
        </form>
    </div>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }