@page
@model QLNT.Pages_ThanhToan.EditModel

@{
    ViewData["Title"] = "Sửa thanh toán";
}

<h1>Sửa thanh toán</h1>

<hr />

@if (Model.HoaDonDangThanhToan != null)
{
    <div class="card mb-4">
        <div class="card-body">
            <h5>Thông tin hóa đơn</h5>

            <p>
                <strong>Phòng:</strong>
                @(Model.HoaDonDangThanhToan.HopDong?.Phong?.TenPhong ?? Model.HoaDonDangThanhToan.TenPhong)
            </p>

            <p>
                <strong>Khách thuê:</strong>
                @Model.HoaDonDangThanhToan.HopDong?.NguoiThue?.HoTen
            </p>

            <p>
                <strong>Tháng/Năm:</strong>
                @Model.HoaDonDangThanhToan.Thang/@Model.HoaDonDangThanhToan.Nam
            </p>

            <p>
                <strong>Số tiền:</strong>
                @Model.SoTienHienThi
            </p>
        </div>
    </div>
}

<div class="row">
    <div class="col-md-5">
        <form method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <input asp-for="ThanhToan.ThanhToanId" type="hidden" />
            <input asp-for="ThanhToan.HoaDonId" type="hidden" />

            <div class="form-group mb-3">
                <label class="control-label">Số tiền</label>
                <input value="@Model.SoTienHienThi" class="form-control" readonly />
            </div>

            <div class="form-group mb-3">
                <span class="text-danger">*</span>
                <label asp-for="ThanhToan.NgayThanhToan" class="control-label">Ngày thanh toán</label>
                <input asp-for="ThanhToan.NgayThanhToan" class="form-control" type="date" />
                <span asp-validation-for="ThanhToan.NgayThanhToan" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <span class="text-danger">*</span>
                <label asp-for="ThanhToan.PhuongThuc" class="control-label">Phương thức thanh toán</label>

                <select asp-for="ThanhToan.PhuongThuc" class="form-control">
                    <option value="Tiền mặt">Tiền mặt</option>
                    <option value="Chuyển khoản">Chuyển khoản</option>
                    <option value="Ví điện tử">Ví điện tử</option>
                </select>

                <span asp-validation-for="ThanhToan.PhuongThuc" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ThanhToan.GhiChu" class="control-label">Ghi chú</label>
                <input asp-for="ThanhToan.GhiChu" class="form-control" />
                <span asp-validation-for="ThanhToan.GhiChu" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Lưu" class="btn btn-primary" />
                <a asp-page="/HoaDon/Index" class="btn btn-secondary">Quay lại</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}