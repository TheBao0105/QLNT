@page
@model QLNT.Pages_Phong.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<form method="get" class="mb-3 row g-2 align-items-center">
    <div class="col-auto">
        <input type="text" name="searchString" value="@Model.CurrentFilter" class="form-control"
               placeholder="Tìm tên phòng" />
    </div>
    <div class="col-auto">
        <select asp-for="StatusFilter" class="form-select">
            <option value="">Tất cả trạng thái</option>
            <option value="Trống">Trống</option>
            <option value="Đã thuê">Đã thuê</option>
            <option value="Bảo trì">Bảo trì</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Tìm kiếm</button>
    </div>
</form>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Phong[0].TenPhong)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Phong[0].GiaPhong)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Phong[0].DienTich)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Phong[0].TrangThai)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Phong[0].GhiChu)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Phong)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.TenPhong)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.GiaPhong)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DienTich)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TrangThai)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.GhiChu)
                </td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.PhongId">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@item.PhongId">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@item.PhongId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<nav aria-label="Page navigation">
    <ul class="pagination">
        @if (Model.Phong.HasPreviousPage)
        {
            <li class="page-item">
                <a class="page-link" asp-page="./Index" asp-route-pageIndex="@(Model.Phong.PageIndex - 1)"
                   asp-route-currentFilter="@Model.CurrentFilter" asp-route-statusFilter="@Model.StatusFilter">Previous</a>
            </li>
        }
        else
        {
            <li class="page-item disabled">
                <span class="page-link">Previous</span>
            </li>
        }

        @for (int i = 1; i <= Model.Phong.TotalPages; i++)
        {
            if (i == Model.Phong.PageIndex)
            {
                <li class="page-item active">
                    <span class="page-link">@i</span>
                </li>
            }
            else
            {
                <li class="page-item">
                    <a class="page-link" asp-page="./Index" asp-route-pageIndex="@i"
                       asp-route-currentFilter="@Model.CurrentFilter" asp-route-statusFilter="@Model.StatusFilter">@i</a>
                </li>
            }
        }

        @if (Model.Phong.HasNextPage)
        {
            <li class="page-item">
                <a class="page-link" asp-page="./Index" asp-route-pageIndex="@(Model.Phong.PageIndex + 1)"
                   asp-route-currentFilter="@Model.CurrentFilter" asp-route-statusFilter="@Model.StatusFilter">Next</a>
            </li>
        }
        else
        {
            <li class="page-item disabled">
                <span class="page-link">Next</span>
            </li>
        }
    </ul>
</nav>
