@page
@model QLNT.Pages_Phong.EditModel

@{
    ViewData["Title"] = "Sửa phòng";
}

<h1>Sửa phòng</h1>

<h4>Phòng</h4>
<hr />

<div class="row">
    <div class="col-md-4">
        <form method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Phong.PhongId" />
            <input type="hidden" asp-for="Phong.HinhAnh" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-2">
                <span class="text-danger">*</span>
                <label asp-for="Phong.TenPhong" class="control-label">Tên phòng</label>
                <input asp-for="Phong.TenPhong" class="form-control" />
                <span asp-validation-for="Phong.TenPhong" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <span class="text-danger">*</span>
                <label class="control-label">Giá phòng</label>
                <div class="input-group">
                    <input asp-for="GiaPhongText" type="text" class="form-control vnd-input" autocomplete="off" />
                    <span class="input-group-text">VNĐ</span>
                </div>
                <span asp-validation-for="GiaPhongText" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label asp-for="Phong.DienTich" class="control-label">Diện tích</label>

                <div class="input-group">
                    <input asp-for="Phong.DienTich" type="text" class="form-control" autocomplete="off" />
                    <span class="input-group-text">m²</span>
                </div>

                <span asp-validation-for="Phong.DienTich" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label asp-for="Phong.TrangThai" class="control-label">Trạng thái</label>
                <select asp-for="Phong.TrangThai" class="form-control">
                    <option value="Trống">Trống</option>
                    <option value="Đã thuê">Đã thuê</option>
                    <option value="Bảo trì">Bảo trì</option>
                </select>
                <span asp-validation-for="Phong.TrangThai" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label asp-for="Phong.GhiChu" class="control-label">Ghi chú</label>
                <input asp-for="Phong.GhiChu" class="form-control" />
                <span asp-validation-for="Phong.GhiChu" class="text-danger"></span>
            </div>

            @if (!string.IsNullOrEmpty(Model.Phong.HinhAnh))
            {
                <div class="form-group mb-2">
                    <label class="control-label">Ảnh hiện tại</label>
                    <img src="@Model.Phong.HinhAnh" class="img-thumbnail" style="max-width: 200px;" />
                </div>
            }

            <div class="form-group mb-2">
                <label asp-for="HinhAnhUpload" class="control-label">Thay đổi hình ảnh phòng</label>
                <input asp-for="HinhAnhUpload" type="file" class="form-control" accept="image/*" />
                <small class="form-text text-muted">Các định dạng hỗ trợ: JPG, PNG, GIF. Kích thước tối đa: 5MB</small>
                <span asp-validation-for="HinhAnhUpload" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Lưu" class="btn btn-primary" />
                <a asp-page="./Index" class="btn btn-secondary">Quay lại</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function formatVnd(value) {
            value = value.replace(/\D/g, "");

            if (value === "") {
                return "";
            }

            return value.replace(/\B(?=(\d{3})+(?!\d))/g, ".");
        }

        document.querySelectorAll(".vnd-input").forEach(function (input) {
            input.addEventListener("input", function () {
                this.value = formatVnd(this.value);
            });

            input.value = formatVnd(input.value);
        });
    </script>
}