@page
@model QLNT.Pages_HoaDon.EditModel

@{
    ViewData["Title"] = "Sửa hóa đơn";
}

<h1>Sửa hóa đơn</h1>

<h4>Hóa đơn</h4>
<hr />

<div class="row">
    <div class="col-md-5">
        <form method="post" id="hoaDonForm">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="HoaDon.HoaDonId" />

            <div class="form-group mb-2">
                <span class="text-danger">*</span>
                <label asp-for="HoaDon.HopDongId" class="control-label">Hợp đồng</label>
                <select asp-for="HoaDon.HopDongId" class="form-control" asp-items="ViewBag.HopDongId"></select>
                <span asp-validation-for="HoaDon.HopDongId" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <span class="text-danger">*</span>
                <label asp-for="HoaDon.Thang" class="control-label">Tháng</label>
                <input asp-for="HoaDon.Thang" class="form-control" />
                <span asp-validation-for="HoaDon.Thang" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <span class="text-danger">*</span>
                <label asp-for="HoaDon.Nam" class="control-label">Năm</label>
                <input asp-for="HoaDon.Nam" class="form-control" />
                <span asp-validation-for="HoaDon.Nam" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <span class="text-danger">*</span>
                <label class="control-label">Tiền phòng</label>
                <div class="input-group">
                    <input asp-for="TienPhongText" type="text" class="form-control vnd-input" autocomplete="off" />
                    <span class="input-group-text">VNĐ</span>
                </div>
                <span asp-validation-for="TienPhongText" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label class="control-label">Tiền điện</label>
                <div class="input-group">
                    <input asp-for="TienDienText" type="text" class="form-control vnd-input" autocomplete="off" />
                    <span class="input-group-text">VNĐ</span>
                </div>
                <span asp-validation-for="TienDienText" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label class="control-label">Tiền nước</label>
                <div class="input-group">
                    <input asp-for="TienNuocText" type="text" class="form-control vnd-input" autocomplete="off" />
                    <span class="input-group-text">VNĐ</span>
                </div>
                <span asp-validation-for="TienNuocText" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label class="control-label">Tiền dịch vụ</label>
                <div class="input-group">
                    <input asp-for="TienDichVuText" type="text" class="form-control vnd-input" autocomplete="off" />
                    <span class="input-group-text">VNĐ</span>
                </div>
                <span asp-validation-for="TienDichVuText" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label class="control-label">Tổng tiền</label>
                <div class="input-group">
                    <input asp-for="TongTienText" type="text" class="form-control" readonly />
                    <span class="input-group-text">VNĐ</span>
                </div>
                <span asp-validation-for="TongTienText" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label asp-for="HoaDon.NgayLap" class="control-label">Ngày lập</label>
                <input asp-for="HoaDon.NgayLap" class="form-control" />
                <span asp-validation-for="HoaDon.NgayLap" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label asp-for="HoaDon.TrangThai" class="control-label">Trạng thái</label>
                <select asp-for="HoaDon.TrangThai" class="form-control">
                    <option value="">-- Chọn trạng thái --</option>
                    <option value="Chưa thanh toán">Chưa thanh toán</option>
                    <option value="Đang thanh toán">Đang thanh toán</option>
                    <option value="Đã thanh toán">Đã thanh toán</option>
                </select>
                <span asp-validation-for="HoaDon.TrangThai" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label asp-for="HoaDon.GhiChu" class="control-label">Ghi chú</label>
                <input asp-for="HoaDon.GhiChu" class="form-control" />
                <span asp-validation-for="HoaDon.GhiChu" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Lưu" class="btn btn-primary" />
                <a asp-page="./Index" class="btn btn-secondary">Quay lại</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function formatVnd(value) {
            value = value.replace(/\D/g, "");

            if (value === "") {
                return "";
            }

            return value.replace(/\B(?=(\d{3})+(?!\d))/g, ".");
        }

        document.querySelectorAll(".vnd-input").forEach(function (input) {
            input.addEventListener("input", function () {
                this.value = formatVnd(this.value);
            });

            input.value = formatVnd(input.value);
        });
    </script>
}