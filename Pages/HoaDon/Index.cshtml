@page
@model QLNT.Pages_HoaDon.IndexModel
@using System.Globalization

@{
    ViewData["Title"] = "Quản lý Hóa đơn & Thanh toán";
    var viVN = new CultureInfo("vi-VN");
}

<h1>Quản lý Hóa đơn & Thanh toán</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<p class="text-end">
    <a asp-page="./Create" class="btn btn-primary">
        + Tạo hóa đơn
    </a>
</p>

<table class="table table-bordered hoa-don-table">
    <thead>
        <tr>
            <th class="col-han">Hạn thanh toán</th>
            <th class="col-thang">Tháng/Năm</th>
            <th class="col-phong">Phòng</th>
            <th class="col-khach">Khách thuê</th>
            <th class="col-tien">Tiền phòng</th>
            <th class="col-dien">Điện</th>
            <th class="col-nuoc">Nước</th>
            <th class="col-dichvu">Dịch vụ</th>
            <th class="col-tong">Tổng tiền</th>
            <th class="col-trangthai">Trạng thái</th>
            <th class="col-thaotac">Thao tác</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.HoaDonList)
        {
            var thanhToan = item.ThanhToans?
                .OrderByDescending(t => t.NgayThanhToan)
                .FirstOrDefault();

            var quaHan = item.TrangThai != "Đã thanh toán"
                && item.HanThanhToan.HasValue
                && item.HanThanhToan.Value.Date < DateTime.Today;

            <tr>
                <td>
                    @(item.HanThanhToan?.ToString("dd/MM/yyyy") ?? "Chưa có")
                </td>

                <td>@item.Thang/@item.Nam</td>

                <td>
                    @(item.HopDong?.Phong?.TenPhong ?? item.TenPhong)
                </td>

                <td>
                    @item.HopDong?.NguoiThue?.HoTen
                </td>

                <td>
                    @item.TienPhong.ToString("N0", viVN) VNĐ
                </td>

                <td>
                    <strong>Số điện tiêu thụ:</strong><br />
                    @item.SoDienTieuThu.ToString("N0", viVN) kWh
                    <br />
                    <strong>Tiền điện:</strong><br />
                    <small>@item.TienDien.ToString("N0", viVN) VNĐ</small>
                </td>

                <td>
                    <strong>Số nước tiêu thụ:</strong><br />
                    @item.SoNuocTieuThu.ToString("N0", viVN) m³
                    <br />
                    <strong>Tiền nước:</strong><br />
                    <small>@item.TienNuoc.ToString("N0", viVN) VNĐ</small>
                </td>

                <td>
                    @item.TienDichVu.ToString("N0", viVN) VNĐ
                </td>

                <td>
                    <strong>@item.TongTien.ToString("N0", viVN) VNĐ</strong>
                </td>

                <td>
                    @if (item.TrangThai == "Đã thanh toán")
                    {
                        <span class="text-success fw-bold">Đã thanh toán</span>

                        @if (thanhToan != null)
                        {
                            <br />
                            <small>
                                @thanhToan.PhuongThuc - @thanhToan.NgayThanhToan.ToString("dd/MM/yyyy")
                            </small>
                        }
                    }
                    else if (quaHan)
                    {
                        <span class="text-danger fw-bold">Quá hạn</span>
                    }
                    else
                    {
                        <span class="text-warning fw-bold">Chưa thanh toán</span>
                    }
                </td>

                <td>
                    @if (item.TrangThai != "Đã thanh toán")
                    {
                        <a asp-page="/ThanhToan/Create" asp-route-hoaDonId="@item.HoaDonId" class="btn btn-sm btn-success">
                            Thanh toán
                        </a>
                    }

                    <a asp-page="./Details" asp-route-id="@item.HoaDonId" class="btn btn-sm btn-info">
                        Chi tiết
                    </a>

                    @if (item.TrangThai != "Đã thanh toán")
                    {
                        <a asp-page="./Edit" asp-route-id="@item.HoaDonId" class="btn btn-sm btn-primary">
                            Sửa
                        </a>
                    }

                    <a asp-page="./Delete" asp-route-id="@item.HoaDonId" class="btn btn-sm btn-danger">
                        Xóa
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>