@page
@model IndexModel
@{
    ViewData["Title"] = "Trang chủ";
    var s = Model.Stats;
    var tyLeThue = s.TongPhong > 0
        ? (int)Math.Round(100.0 * s.PhongDangThue / s.TongPhong)
        : 0;
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
}

<div class="home-page">

    <section class="home-hero">
        <div class="home-hero__bg" aria-hidden="true"></div>
        <div class="container home-hero__content">
            <div class="row align-items-center g-4">
                <div class="col-lg-7">
                    <span class="home-badge">
                        <i class="bi bi-building"></i> QLNT
                    </span>
                    <h1 class="home-hero__title">Quản lý nhà trọ<br class="d-none d-sm-block" /> thông minh &amp; gọn
                        gàng</h1>
                        <p class="home-hero__lead">
                            Theo dõi phòng, người thuê, hợp đồng, hóa đơn và thanh toán trên một nền tảng —
                            tiết kiệm thời gian, giảm sai sót.
                        </p>
                        <div class="d-flex flex-wrap gap-2 home-hero__actions">
                            <a asp-page="/Dashboard/Index" class="btn btn-light btn-lg px-4 shadow-sm">
                                <i class="bi bi-speedometer2 me-2"></i>Xem dashboard
                            </a>
                            <a asp-page="/Phong/Index" class="btn btn-outline-light btn-lg px-4">
                                <i class="bi bi-door-open me-2"></i>Quản lý phòng
                            </a>
                        </div>
                    </div>
                    <div class="col-lg-5">
                        <div class="home-hero-card">
                            <div class="home-hero-card__header">
                                <i class="bi bi-pie-chart-fill"></i>
                                <span>Tình trạng hiện tại</span>
                            </div>
                            <div class="home-hero-card__stat">
                                <span class="home-hero-card__value">@tyLeThue%</span>
                                <span class="home-hero-card__label">Tỷ lệ lấp đầy phòng</span>
                            </div>
                            <div class="progress home-progress mb-3" role="progressbar" aria-valuenow="@tyLeThue"
                                 aria-valuemin="0" aria-valuemax="100">
                                <div class="progress-bar" style="width: @tyLeThue%"></div>
                            </div>
                            <ul class="home-hero-card__list">
                                <li>
                                    <span class="dot dot--success"></span>
                                    @s.PhongDangThue phòng đang thuê
                                </li>
                                <li>
                                    <span class="dot dot--info"></span>
                                    @s.PhongTrong phòng trống
                                </li>
                                <li>
                                    <span class="dot dot--warning"></span>
                                    @s.HopDongDangHieuLuc hợp đồng hiệu lực
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        @if (s.HoaDonQuaHan > 0)
        {
            <div class="container mt-4">
                <div class="alert alert-warning home-alert d-flex align-items-center gap-3 mb-0" role="alert">
                    <i class="bi bi-exclamation-triangle-fill fs-4 flex-shrink-0"></i>
                    <div>
                        <strong>Cần chú ý:</strong> Có <strong>@s.HoaDonQuaHan</strong> hóa đơn quá hạn thanh toán.
                        <a asp-page="/HoaDon/Index" class="alert-link ms-1">Xem ngay →</a>
                    </div>
                </div>
            </div>
        }

        <section class="container home-stats">
            <div class="row g-3 g-md-4">
                <div class="col-6 col-lg-3">
                    <div class="home-stat-card home-stat-card--primary">
                        <div class="home-stat-card__icon"><i class="bi bi-door-closed"></i></div>
                        <div>
                            <div class="home-stat-card__value">@s.TongPhong</div>
                            <div class="home-stat-card__label">Tổng phòng</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="home-stat-card home-stat-card--success">
                        <div class="home-stat-card__icon"><i class="bi bi-people"></i></div>
                        <div>
                            <div class="home-stat-card__value">@s.TongNguoiThue</div>
                            <div class="home-stat-card__label">Người thuê</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="home-stat-card home-stat-card--danger">
                        <div class="home-stat-card__icon"><i class="bi bi-receipt"></i></div>
                        <div>
                            <div class="home-stat-card__value">@s.HoaDonChuaThanhToan</div>
                            <div class="home-stat-card__label">Hóa đơn chưa TT</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="home-stat-card home-stat-card--revenue">
                        <div class="home-stat-card__icon"><i class="bi bi-cash-stack"></i></div>
                        <div>
                            <div class="home-stat-card__value home-stat-card__value--sm">
                                @s.DoanhThuThangNay.ToString("N0")
                            </div>
                            <div class="home-stat-card__label">Doanh thu tháng (VNĐ)</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <section class="home-cta">
            <div class="container">
                <div class="home-cta__inner">
                    <div>
                        <h2 class="home-cta__title">Bắt đầu ngay hôm nay</h2>
                        <p class="home-cta__text mb-0">
                            Cập nhật phòng trống, tạo hóa đơn tháng mới hoặc xem báo cáo doanh thu — tất cả trong vài cú
                            nhấp.
                        </p>
                    </div>
                    <div class="d-flex flex-wrap gap-2 justify-content-lg-end">
                        <a asp-page="/HoaDon/Create" class="btn btn-primary btn-lg">
                            <i class="bi bi-plus-lg me-1"></i>Tạo hóa đơn
                        </a>
                        <a asp-page="/Phong/Create" class="btn btn-outline-primary btn-lg">
                            <i class="bi bi-plus-lg me-1"></i>Thêm phòng
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <section class="container home-modules">
            <div class="home-section-header">
                <h2 class="home-section-header__title">Chức năng hệ thống</h2>
                <p class="home-section-header__sub">Chọn module để bắt đầu quản lý</p>
            </div>

            <p class="home-group-label">Quản lý cơ bản</p>
            <div class="row g-3 g-md-4 mb-4">
                <div class="col-md-6 col-xl-4">
                    <a asp-page="/Phong/Index" class="home-module-card home-module-card--blue">
                        <div class="home-module-card__icon"><i class="bi bi-door-open-fill"></i></div>
                        <div class="home-module-card__body">
                            <h3>Quản lý phòng</h3>
                            <p>Thêm, sửa, theo dõi trạng thái và thông tin từng phòng trọ.</p>
                            <span class="home-module-card__link">Vào quản lý <i class="bi bi-arrow-right"></i></span>
                        </div>
                    </a>
                </div>
                <div class="col-md-6 col-xl-4">
                    <a asp-page="/NguoiThue/Index" class="home-module-card home-module-card--teal">
                        <div class="home-module-card__icon"><i class="bi bi-person-vcard-fill"></i></div>
                        <div class="home-module-card__body">
                            <h3>Người thuê</h3>
                            <p>Lưu trữ hồ sơ, liên hệ và lịch sử thuê của từng khách.</p>
                            <span class="home-module-card__link">Vào quản lý <i class="bi bi-arrow-right"></i></span>
                        </div>
                    </a>
                </div>
                <div class="col-md-6 col-xl-4">
                    <a asp-page="/HopDong/Index" class="home-module-card home-module-card--indigo">
                        <div class="home-module-card__icon"><i class="bi bi-file-earmark-text-fill"></i></div>
                        <div class="home-module-card__body">
                            <h3>Hợp đồng</h3>
                            <p>Tạo và quản lý hợp đồng thuê, thời hạn và giá thuê.</p>
                            <span class="home-module-card__link">Vào quản lý <i class="bi bi-arrow-right"></i></span>
                        </div>
                    </a>
                </div>
            </div>

            <p class="home-group-label">Tài chính</p>
            <div class="row g-3 g-md-4 mb-4">
                <div class="col-md-6 col-xl-4">
                    <a asp-page="/HoaDon/Index" class="home-module-card home-module-card--green">
                        <div class="home-module-card__icon"><i class="bi bi-receipt-cutoff"></i></div>
                        <div class="home-module-card__body">
                            <h3>Hóa đơn</h3>
                            <p>Lập hóa đơn tiền phòng, dịch vụ và theo dõi trạng thái thanh toán.</p>
                            <span class="home-module-card__link">Vào quản lý <i class="bi bi-arrow-right"></i></span>
                        </div>
                    </a>
                </div>

                <div class="col-md-6 col-xl-4">
                    <a asp-page="/DichVu/Index" class="home-module-card home-module-card--amber">
                        <div class="home-module-card__icon"><i class="bi bi-lightning-charge-fill"></i></div>
                        <div class="home-module-card__body">
                            <h3>Dịch vụ</h3>
                            <p>Điện, nước, internet và các khoản phí dịch vụ khác.</p>
                            <span class="home-module-card__link">Vào quản lý <i class="bi bi-arrow-right"></i></span>
                        </div>
                    </a>
                </div>
            </div>

            <p class="home-group-label">Hệ thống</p>
            <div class="row g-3 g-md-4">
                <div class="col-md-6 col-xl-4">
                    <a asp-page="/TaiKhoan/Index" class="home-module-card home-module-card--slate">
                        <div class="home-module-card__icon"><i class="bi bi-shield-lock-fill"></i></div>
                        <div class="home-module-card__body">
                            <h3>Tài khoản</h3>
                            <p>Quản lý tài khoản đăng nhập và phân quyền hệ thống.</p>
                            <span class="home-module-card__link">Vào quản lý <i class="bi bi-arrow-right"></i></span>
                        </div>
                    </a>
                </div>
                <div class="col-md-6 col-xl-4">
                    <a asp-page="/Dashboard/Index" class="home-module-card home-module-card--violet">
                        <div class="home-module-card__icon"><i class="bi bi-graph-up-arrow"></i></div>
                        <div class="home-module-card__body">
                            <h3>Dashboard</h3>
                            <p>Báo cáo tổng hợp, thống kê chi tiết toàn bộ hoạt động.</p>
                            <span class="home-module-card__link">Xem thống kê <i class="bi bi-arrow-right"></i></span>
                        </div>
                    </a>
                </div>
            </div>
        </section>
    </div>
