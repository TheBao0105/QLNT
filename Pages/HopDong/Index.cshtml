@page
@model QLNT.Pages_HopDong.IndexModel
@using System.Globalization

@{
    ViewData["Title"] = "Danh sách hợp đồng";
    var viVN = new CultureInfo("vi-VN");
}

<h1>Danh sách hợp đồng</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Thêm mới</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>ID Hợp đồng</th>
            <th>Ngày bắt đầu</th>
            <th>Ngày kết thúc</th>
            <th>Tiền cọc</th>
            <th>Giá thuê</th>
            <th>Trạng thái</th>
            <th>Ghi chú</th>
            <th>Phòng</th>
            <th>Người thuê</th>
            <th>Thao tác</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.HopDong)
        {
            var trangThai = Model.TinhTrangThaiHopDong(item.NgayBatDau, item.NgayKetThuc);

            <tr>
                <td>@item.HopDongId</td>
                <td>@item.NgayBatDau.ToString("dd/MM/yyyy")</td>
                <td>@(item.NgayKetThuc.HasValue ? item.NgayKetThuc.Value.ToString("dd/MM/yyyy") : "")</td>
                <td>@item.TienCoc.ToString("N0", viVN) VNĐ</td>
                <td>@item.GiaThue.ToString("N0", viVN) VNĐ</td>
                <td>
                    @if (trangThai == "Còn hạn")
                    {
                        <span class="badge bg-success">Còn hạn</span>
                    }
                    else if (trangThai == "Hết hạn")
                    {
                        <span class="badge bg-danger">Hết hạn</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Chưa bắt đầu</span>
                    }
                </td>
                <td>@Html.DisplayFor(modelItem => item.GhiChu)</td>
                <td>@Html.DisplayFor(modelItem => item.Phong.TenPhong)</td>
                <td>@Html.DisplayFor(modelItem => item.NguoiThue.HoTen)</td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.HopDongId">Sửa</a> |
                    <a asp-page="./Details" asp-route-id="@item.HopDongId">Chi tiết</a> |
                    <a asp-page="./Delete" asp-route-id="@item.HopDongId">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>