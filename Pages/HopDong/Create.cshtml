@page
@model QLNT.Pages_HopDong.CreateModel

@{
    ViewData["Title"] = "Thêm hợp đồng";
}

<h1>Thêm hợp đồng</h1>

<h4>Hợp đồng</h4>
<hr />

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="form-group mb-3">
                <span class="text-danger">*</span>
                <label asp-for="Input.PhongId" class="control-label">Phòng</label>

                <select asp-for="Input.PhongId" class="form-select">
                    <option value="">-- Chọn phòng --</option>

                    @foreach (var phong in Model.DanhSachPhong)
                    {
                        if (phong.PhongId == Model.Input.PhongId)
                        {
                            <option value="@phong.PhongId" selected>
                                @phong.TenPhong - @Model.FormatVnd(phong.GiaPhong) VNĐ - @phong.TrangThai
                            </option>
                        }
                        else
                        {
                            <option value="@phong.PhongId">
                                @phong.TenPhong - @Model.FormatVnd(phong.GiaPhong) VNĐ - @phong.TrangThai
                            </option>
                        }
                    }
                </select>

                <span asp-validation-for="Input.PhongId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <span class="text-danger">*</span>
                <label asp-for="Input.NguoiThueId" class="control-label">Người thuê</label>

                <select asp-for="Input.NguoiThueId" class="form-select" asp-items="Model.NguoiThueSelectList">
                    <option value="">-- Chọn người thuê --</option>
                </select>

                <span asp-validation-for="Input.NguoiThueId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <span class="text-danger">*</span>
                <label asp-for="Input.NgayBatDau" class="control-label">Ngày bắt đầu</label>
                <input asp-for="Input.NgayBatDau" type="date" class="form-control" />
                <span asp-validation-for="Input.NgayBatDau" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Input.NgayKetThuc" class="control-label">Ngày kết thúc</label>
                <input asp-for="Input.NgayKetThuc" type="date" class="form-control" />
                <span asp-validation-for="Input.NgayKetThuc" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Tiền cọc</label>

                <div class="input-group">
                    <input value="@Model.FormatVnd(Model.Input.TienCoc)" class="form-control" readonly />
                    <span class="input-group-text">VNĐ</span>
                </div>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Giá thuê</label>

                <div class="input-group">
                    <input value="@Model.FormatVnd(Model.Input.GiaThue)" class="form-control" readonly />
                    <span class="input-group-text">VNĐ</span>
                </div>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Trạng thái</label>
                <input value="@Model.Input.TrangThai" class="form-control" readonly />
            </div>

            <div class="form-group mb-3">
                <label asp-for="Input.GhiChu" class="control-label">Ghi chú</label>
                <textarea asp-for="Input.GhiChu" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Input.GhiChu" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <button type="submit" name="FormAction" value="preview" class="btn btn-secondary">
                    Đồng bộ tiền
                </button>

                <button type="submit" name="FormAction" value="create" class="btn btn-primary">
                    Thêm
                </button>

                <a asp-page="./Index" class="btn btn-outline-secondary">
                    Quay lại
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}