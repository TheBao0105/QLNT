@page
@model QLNT.Pages_HopDong.DetailsModel
@using System.Globalization

@{
    ViewData["Title"] = "Chi tiết hợp đồng";
    var viVN = new CultureInfo("vi-VN");
}

<h1>Chi tiết hợp đồng</h1>

<div>
    <h4>Hợp đồng</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">ID hợp đồng</dt>
        <dd class="col-sm-10">@Model.HopDong.HopDongId</dd>

        <dt class="col-sm-2">Phòng</dt>
        <dd class="col-sm-10">@Model.HopDong.Phong?.TenPhong</dd>

        <dt class="col-sm-2">Người thuê</dt>
        <dd class="col-sm-10">@Model.HopDong.NguoiThue?.HoTen</dd>

        <dt class="col-sm-2">Ngày bắt đầu</dt>
        <dd class="col-sm-10">@Model.HopDong.NgayBatDau.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-2">Ngày kết thúc</dt>
        <dd class="col-sm-10">
            @(Model.HopDong.NgayKetThuc.HasValue
                ? Model.HopDong.NgayKetThuc.Value.ToString("dd/MM/yyyy")
                : "")
        </dd>

        <dt class="col-sm-2">Tiền cọc</dt>
        <dd class="col-sm-10">@Model.HopDong.TienCoc.ToString("N0", viVN) VNĐ</dd>

        <dt class="col-sm-2">Giá thuê</dt>
        <dd class="col-sm-10">@Model.HopDong.GiaThue.ToString("N0", viVN) VNĐ</dd>

        <dt class="col-sm-2">Trạng thái</dt>
        <dd class="col-sm-10">@Model.HopDong.TrangThai</dd>

        <dt class="col-sm-2">Ghi chú</dt>
        <dd class="col-sm-10">@Model.HopDong.GhiChu</dd>
    </dl>
</div>

<div>
    <a asp-page="./Edit" asp-route-id="@Model.HopDong.HopDongId" class="btn btn-primary">Sửa</a>
    <a asp-page="./Index" class="btn btn-secondary">Quay lại</a>
</div>