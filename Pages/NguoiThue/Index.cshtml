@page
@model QLNT.Pages_NguoiThue.IndexModel

@{
    ViewData["Title"] = "Danh sách người thuê";
}

<h1>Danh sách người thuê</h1>

<form method="get" class="mb-3 row g-2 align-items-center">
    <div class="col-auto">
        <input type="text" name="searchString" value="@Model.CurrentFilter" class="form-control"
               placeholder="Tìm tên, số điện thoại hoặc CCCD" />
    </div>

    <div class="col-auto">
        <button type="submit" class="btn btn-primary">
            Tìm kiếm
        </button>
    </div>
</form>

<div class="mb-3">
    <a asp-page="Create" class="btn btn-primary">
        Thêm người thuê
    </a>
</div>

<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>Họ tên</th>
                <th>Số điện thoại</th>
                <th>Email</th>
                <th>CCCD</th>
                <th>Ngày sinh</th>
                <th>Địa chỉ</th>
                <th>Thao tác</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model.NguoiThue)
            {
                <tr>
                    <td>@item.HoTen</td>

                    <td>
                        @(string.IsNullOrWhiteSpace(item.SoDienThoai) ? "Không có" : item.SoDienThoai)
                    </td>

                    <td>
                        @(string.IsNullOrWhiteSpace(item.Email) ? "Không có" : item.Email)
                    </td>

                    <td>
                        @(string.IsNullOrWhiteSpace(item.CCCD) ? "Không có" : item.CCCD)
                    </td>

                    <td>
                        @(item.NgaySinh.HasValue ? item.NgaySinh.Value.ToString("dd/MM/yyyy") : "Không có")
                    </td>

                    <td>
                        @(string.IsNullOrWhiteSpace(item.DiaChi) ? "Không có" : item.DiaChi)
                    </td>

                    <td>
                        <div class="action-buttons">
                            <a asp-page="./Edit" asp-route-id="@item.NguoiThueId" class="btn btn-primary">
                                Sửa
                            </a>

                            <a asp-page="./Details" asp-route-id="@item.NguoiThueId" class="btn btn-info">
                                Chi tiết
                            </a>

                            <a asp-page="./Delete" asp-route-id="@item.NguoiThueId" class="btn btn-danger">
                                Xóa
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<nav aria-label="Page navigation">
    <ul class="pagination">
        @if (Model.NguoiThue.HasPreviousPage)
        {
            <li class="page-item">
                <a class="page-link" asp-page="./Index" asp-route-pageIndex="@(Model.NguoiThue.PageIndex - 1)"
                   asp-route-currentFilter="@Model.CurrentFilter">Previous</a>
            </li>
        }
        else
        {
            <li class="page-item disabled">
                <span class="page-link">Previous</span>
            </li>
        }

        @for (var i = 1; i <= Model.NguoiThue.TotalPages; i++)
        {
            if (i == Model.NguoiThue.PageIndex)
            {
                <li class="page-item active">
                    <span class="page-link">@i</span>
                </li>
            }
            else
            {
                <li class="page-item">
                    <a class="page-link" asp-page="./Index" asp-route-pageIndex="@i"
                       asp-route-currentFilter="@Model.CurrentFilter">@i</a>
                </li>
            }
        }

        @if (Model.NguoiThue.HasNextPage)
        {
            <li class="page-item">
                <a class="page-link" asp-page="./Index" asp-route-pageIndex="@(Model.NguoiThue.PageIndex + 1)"
                   asp-route-currentFilter="@Model.CurrentFilter">Next</a>
            </li>
        }
        else
        {
            <li class="page-item disabled">
                <span class="page-link">Next</span>
            </li>
        }
    </ul>
</nav>
