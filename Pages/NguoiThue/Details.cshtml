@page
@model QLNT.Pages_NguoiThue.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Chi tiết người thuê</h1>

<div class="details-card">
    <div class="details-header">
        <h2>Thông tin người thuê</h2>
    </div>

    <dl class="row details-list">
        <dt class="col-sm-3">
            Họ tên
        </dt>
        <dd class="col-sm-9">
            @Model.NguoiThue.HoTen
        </dd>

        <dt class="col-sm-3">
            Số điện thoại
        </dt>
        <dd class="col-sm-9">
            @(string.IsNullOrWhiteSpace(Model.NguoiThue.SoDienThoai) ? "Không có" : Model.NguoiThue.SoDienThoai)
        </dd>

        <dt class="col-sm-3">
            Email
        </dt>
        <dd class="col-sm-9">
            @(string.IsNullOrWhiteSpace(Model.NguoiThue.Email) ? "Không có" : Model.NguoiThue.Email)
        </dd>

        <dt class="col-sm-3">
            CCCD
        </dt>
        <dd class="col-sm-9">
            @(string.IsNullOrWhiteSpace(Model.NguoiThue.CCCD) ? "Không có" : Model.NguoiThue.CCCD)
        </dd>

        <dt class="col-sm-3">
            Ngày sinh
        </dt>
        <dd class="col-sm-9">
            @(Model.NguoiThue.NgaySinh.HasValue ? Model.NguoiThue.NgaySinh.Value.ToString("dd/MM/yyyy") : "Không có")

            <dt class="col-sm-3">
                Địa chỉ
            </dt>
            <dd class="col-sm-9">
                @(string.IsNullOrWhiteSpace(Model.NguoiThue.DiaChi) ? "Không có" : Model.NguoiThue.DiaChi)
            </dd>
        </dl>
    </div>

    <div class="mt-3">
        <a asp-page="./Edit" asp-route-id="@Model.NguoiThue.NguoiThueId" class="btn btn-primary">
            Sửa
        </a>

        <a asp-page="./Index" class="btn btn-secondary">
            Quay lại
        </a>
    </div>
    <div>
        <a asp-page="./Edit" asp-route-id="@Model.NguoiThue.NguoiThueId">Edit</a> |
        <a asp-page="./Index">Back to List</a>
    </div>
