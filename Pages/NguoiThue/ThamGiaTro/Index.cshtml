@page
@model QLNT.Pages.NguoiThue.ThamGiaTro.IndexModel

<h2>Tham Gia Nhà Trọ</h2>

<form method="post">

    <div class="mb-3">
        <label>Mã nhà trọ</label>
        <input asp-for="MaTro" class="form-control" />
    </div>

    <button type="submit"
            class="btn btn-primary">
        Xác nhận
    </button>

</form>

@if (!string.IsNullOrEmpty(Model.ThongBao))
{
    <div class="alert alert-danger mt-3">
        @Model.ThongBao
    </div>
}