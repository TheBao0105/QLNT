@page
@model QLNT.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Đăng nhập";
}
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="card-title mb-4">Đăng nhập</h2>

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Input.AccountOrEmail" class="form-label"></label>
                        <input asp-for="Input.AccountOrEmail" class="form-control" />
                        <span asp-validation-for="Input.AccountOrEmail" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label"></label>
                        <input asp-for="Input.Password" class="form-control" type="password" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <input asp-for="ReturnUrl" type="hidden" />

                    <button type="submit" class="btn btn-primary">Đăng nhập</button>
                </form>

                <div class="mt-2 text-end">
                    <a asp-page="/Account/ForgotPassword" asp-route-returnUrl="@Model.ReturnUrl">Quên mật khẩu?</a>
                </div>

                <div class="mt-3 text-center">
                    <p>Chưa có tài khoản? <a asp-page="/Account/Register" asp-route-returnUrl="@Model.ReturnUrl">Đăng
                        ký</a></p>
                    </div>

                    <div class="mt-3 text-center">hoặc</div>

                    <form method="post" class="mt-3">
                        <input asp-for="ReturnUrl" type="hidden" />
                        <button type="submit" asp-page-handler="ExternalLogin" asp-route-provider="Google"
                                class="btn btn-outline-danger w-100 mb-2" disabled="@(Model.GoogleEnabled ? null : "disabled")">
                            <i class="bi bi-google"></i> Đăng nhập với Google
                        </button>
                    </form>

                    <form method="post" class="mt-3">
                        <input asp-for="ReturnUrl" type="hidden" />
                        <button type="submit" asp-page-handler="ExternalLogin" asp-route-provider="Facebook"
                                class="btn btn-outline-primary w-100" disabled="@(Model.FacebookEnabled ? null : "disabled")">
                            <i class="bi bi-facebook"></i> Đăng nhập với Facebook
                        </button>
                    </form>
                </div>
            </div>
        </div>

        @section Scripts {
            <partial name="_ValidationScriptsPartial" />
        }
