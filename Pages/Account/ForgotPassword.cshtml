@page
@model QLNT.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="card-title mb-4">Quên mật khẩu</h2>

                <p class="text-muted">Nhập địa chỉ email của bạn. Chúng tôi sẽ gửi mã xác nhận để bạn có thể đặt lại mật
                    khẩu.</p>

                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label"></label>
                            <input asp-for="Input.Email" class="form-control" placeholder="your@email.com" />
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>

                        <input asp-for="ReturnUrl" type="hidden" />

                        <button type="submit" class="btn btn-primary w-100">Gửi mã xác nhận</button>
                    </form>

                    @if (!string.IsNullOrEmpty(Model.StatusMessage))
                    {
                        <div class="alert alert-info mt-4">@Model.StatusMessage</div>
                    }

                    <div class="mt-4 text-center">
                        <a asp-page="/Account/Login" asp-route-returnUrl="@Model.ReturnUrl">Quay lại đăng nhập</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
