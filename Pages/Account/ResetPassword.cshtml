@page
@model QLNT.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="card-title mb-4">Đặt lại mật khẩu</h2>

                @if (string.IsNullOrEmpty(Model.SuccessMessage))
                {
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                        {
                            <div class="alert alert-danger mb-3">@Model.ErrorMessage</div>
                        }

                        <div class="mb-3">
                            <label asp-for="Input.Password" class="form-label"></label>
                            <input asp-for="Input.Password" class="form-control" />
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                            <input asp-for="Input.ConfirmPassword" class="form-control" />
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                        </div>

                        <input type="hidden" asp-for="Email" />
                        <input type="hidden" asp-for="Token" />
                        <input type="hidden" asp-for="ReturnUrl" />

                        <button type="submit" class="btn btn-primary w-100">Cập nhật mật khẩu</button>
                    </form>
                }
                else
                {
                    <div class="alert alert-success mb-4">@Model.SuccessMessage</div>
                    <form method="post" asp-page-handler="LoginRedirect">
                        <input type="hidden" asp-for="ReturnUrl" />
                        <button type="submit" class="btn btn-primary w-100">Đăng nhập</button>
                    </form>
                }

                <div class="mt-4 text-center">
                    <a asp-page="/Account/Login" asp-route-returnUrl="@Model.ReturnUrl">Quay lại đăng nhập</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
