@page
@model QLNT.Pages.Account.VerifyCodeModel
@{
    ViewData["Title"] = "Xác nhận mã";
}
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="card-title mb-4">Xác nhận mã</h2>

                <p class="text-muted">Chúng tôi đã gửi mã xác nhận 6 chữ số đến <strong>@Model.Email</strong></p>

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger mb-3">@Model.ErrorMessage</div>
                    }

                    <div class="mb-3">
                        <label asp-for="Input.Code" class="form-label"></label>
                        <input asp-for="Input.Code" class="form-control form-control-lg text-center"
                               placeholder="000000" maxlength="6" />
                        <span asp-validation-for="Input.Code" class="text-danger"></span>
                    </div>

                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="ReturnUrl" />

                    <button type="submit" class="btn btn-primary w-100">Xác nhận</button>
                </form>

                <div class="mt-4 text-center">
                    <p><small>Không nhận được mã? <a asp-page="/Account/ForgotPassword"
                                                         asp-route-returnUrl="@Model.ReturnUrl">Gửi lại</a></small></p>
                    </div>

                    <div class="mt-4 text-center">
                        <a asp-page="/Account/Login" asp-route-returnUrl="@Model.ReturnUrl">Quay lại đăng nhập</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
